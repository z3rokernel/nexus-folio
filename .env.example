#--------------------------------------------------------------------
# MOSTEPHA AMINE BDEIRA — Example Environment Configuration (.env.example)
# Copy this file to `.env` and customize values. Never commit `.env`.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'https://mabdeira.dev/'
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE (SQLite3 for Dev / MySQLi for Prod)
#--------------------------------------------------------------------

database.default.DBDriver = SQLite3
database.default.database = db.sqlite
database.default.DBPrefix =

# Production MySQL Example:
# database.default.hostname = localhost
# database.default.database = mabdeira_portfolio
# database.default.username = root
# database.default.password =
# database.default.DBDriver = MySQLi
# database.default.port = 3306

database.tests.DBDriver = SQLite3
database.tests.database = ':memory:'
database.tests.DBPrefix =

#--------------------------------------------------------------------
# PORTFOLIO & INTEGRATIONS
#--------------------------------------------------------------------

PORTFOLIO_NAME = 'Mostepha Amine Bdeira'
PORTFOLIO_HANDLE = 'MABDEIRA.DEV'
PORTFOLIO_CITY = 'Lyon, France'
PORTFOLIO_TIMEZONE = 'Europe/Paris'
PORTFOLIO_EMAIL = 'contact@mabdeira.dev'
PORTFOLIO_PHONE = '+33 6 15 21 88 14'
PORTFOLIO_AVAILABILITY = 'Open to Full-Stack PHP/Laravel/CI4, QA & Freelance roles'
GITHUB_USER = 'z3rokernel'
GITHUB_TOKEN = ''
CONTACT_TO = 'contact@mabdeira.dev'

#--------------------------------------------------------------------
# EMAIL
#--------------------------------------------------------------------

email.fromEmail = 'noreply@mabdeira.dev'
email.fromName = 'Mostepha Amine Bdeira (mabdeira.dev)'
email.protocol = 'mail'
email.SMTPHost = ''
email.SMTPUser = ''
email.SMTPPass = ''
email.SMTPPort = 587
