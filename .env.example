#--------------------------------------------------------------------
# NEXUS-FOLIO — Example Environment Configuration (.env.example)
# Copy this file to `.env` and customize values. Never commit `.env`.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE (SQLite3 for Dev / MySQLi for Prod)
#--------------------------------------------------------------------

database.default.DBDriver = SQLite3
database.default.database = db.sqlite
database.default.DBPrefix =

# Production MySQL Example:
# database.default.hostname = localhost
# database.default.database = nexus_folio
# database.default.username = root
# database.default.password =
# database.default.DBDriver = MySQLi
# database.default.port = 3306

database.tests.DBDriver = SQLite3
database.tests.database = ':memory:'
database.tests.DBPrefix =

#--------------------------------------------------------------------
# PORTFOLIO & INTEGRATIONS
#--------------------------------------------------------------------

PORTFOLIO_NAME = 'Mostepha Amine BDEIR'
PORTFOLIO_HANDLE = 'NXS//STUDIO'
PORTFOLIO_CITY = 'Paris, France'
PORTFOLIO_TIMEZONE = 'Europe/Paris'
PORTFOLIO_EMAIL = 'contact@nexus-folio.dev'
PORTFOLIO_AVAILABILITY = 'Open to select freelance & full-time roles'
GITHUB_USER = 'your-github-username'
GITHUB_TOKEN = ''
CONTACT_TO = 'contact@nexus-folio.dev'

#--------------------------------------------------------------------
# EMAIL
#--------------------------------------------------------------------

email.fromEmail = 'noreply@nexus-folio.dev'
email.fromName = 'NEXUS-FOLIO Transmission'
email.protocol = 'mail'
email.SMTPHost = ''
email.SMTPUser = ''
email.SMTPPass = ''
email.SMTPPort = 587
